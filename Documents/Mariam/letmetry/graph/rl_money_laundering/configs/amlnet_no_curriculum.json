{
  "name": "amlnet_no_curriculum",
  "dataset_type": "amlnet",
  "dataset_path": "data/amlnet/AMLNet_August_2025.csv",
  "agent": {
    "state_dim": 80,
    "action_dim": 6,
    "agent_type": "dqn",
    "learning_rate": 0.0005,
    "gamma": 0.99,
    "epsilon_start": 1.0,
    "epsilon_end": 0.05,
    "epsilon_decay": 0.997,
    "buffer_capacity": 50000,
    "use_prioritized_replay": false,
    "use_guided_exploration": true,
    "exploration_temperature": 1.0,
    "hidden_dims": [256, 128],
    "device": "auto"
  },
  "gnn": {
    "node_feature_dim": 20,
    "gnn_type": "sage",
    "embedding_dim": 64,
    "hidden_channels": 64,
    "num_layers": 2,
    "history_dim": 16,
    "dropout": 0.1,
    "heads": 4,
    "device": "auto"
  },
  "environment": {
    "max_steps": 50,
    "max_neighbors": 5,
    "intrinsic_reward_weight": 0.5,
    "step_penalty": -0.01,
    "fraud_reward": 1.0,
    "false_alarm_penalty": -1.0
  },
  "trainer": {
    "num_episodes": 500,
    "batch_size": 64,
    "eval_frequency": 50,
    "checkpoint_frequency": 100,
    "target_update_frequency": 10,
    "curriculum_schedule": [1.0],
    "max_steps_per_episode": 50,
    "num_eval_episodes": 20
  },
  "output_dir": "outputs/amlnet_no_curriculum",
  "seed": 42
}
