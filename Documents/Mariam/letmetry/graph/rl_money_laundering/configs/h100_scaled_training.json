{
  "name": "h100_scaled_training",
  "dataset_type": "amlnet",
  "dataset_path": "data/amlnet/AMLNet_August_2025.csv",
  "agent": {
    "state_dim": 80,
    "action_dim": 6,
    "learning_rate": 0.0005,
    "gamma": 0.99,
    "epsilon_start": 1.0,
    "epsilon_end": 0.15,
    "epsilon_decay": 0.9998,
    "buffer_capacity": 200000,
    "use_prioritized_replay": true,
    "hidden_dims": [
      512,
      512,
      256,
      128
    ],
    "device": "cuda",
    "agent_type": "qrdqn",
    "num_quantiles": 128,
    "n_step": 5,
    "risk_measure": "cvar_90",
    "prioritized_alpha": 0.8,
    "prioritized_beta": 0.6,
    "prioritized_beta_annealing": 0.0005,
    "positive_fraction": 0.25,
    "use_double_dqn": true,
    "use_guided_exploration": true,
    "exploration_temperature": 1.0,
    "gradient_clip": 1.0
  },
  "gnn": {
    "node_feature_dim": 20,
    "gnn_type": "rmganets",
    "embedding_dim": 128,
    "hidden_channels": 320,
    "num_layers": 3,
    "history_dim": 32,
    "dropout": 0.1,
    "heads": 8,
    "device": "cuda",
    "multi_branch": true,
    "use_dqn_enhancement": true,
    "num_classes": 2
  },
  "environment": {
    "max_steps": 200,
    "max_neighbors": 5,
    "intrinsic_reward_weight": 1.0,
    "step_penalty": -0.01,
    "fraud_reward": 10.0,
    "false_alarm_penalty": -10.0
  },
  "trainer": {
    "num_episodes": 10000,
    "batch_size": 256,
    "eval_frequency": 100,
    "checkpoint_frequency": 500,
    "target_update_frequency": 20,
    "curriculum_schedule": [
      1.0,
      1.0,
      1.0,
      0.95,
      0.9,
      0.85,
      0.8,
      0.75,
      0.7,
      0.65,
      0.6,
      0.55,
      0.5
    ],
    "max_steps_per_episode": 200,
    "num_eval_episodes": 50,
    "multi_branch": {
      "enabled": true,
      "variant": "improved",
      "lambda_branch": 0.25,
      "epsilon_dqn": 0.4,
      "beta_reg": 0.1,
      "temporal_decay": 0.1,
      "adaptive_weighting": true,
      "learning_rate": 0.0005,
      "log_frequency": 50
    }
  },
  "output_dir": "outputs/h100_scaled_training",
  "seed": 42,
  "nrows": null
}
