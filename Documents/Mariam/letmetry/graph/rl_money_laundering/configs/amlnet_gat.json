{
  "name": "amlnet_gat",
  "dataset_type": "amlnet",
  "dataset_path": "data/amlnet/AMLNet_August_2025.csv",
  "agent": {
    "state_dim": 80,
    "action_dim": 6,
    "agent_type": "dqn",
    "learning_rate": 0.001,
    "gamma": 0.99,
    "epsilon_start": 1.0,
    "epsilon_end": 0.2,
    "epsilon_decay": 0.999,
    "buffer_capacity": 10000,
    "use_prioritized_replay": true,
    "hidden_dims": [128, 128, 64],
    "device": "auto"
  },
  "gnn": {
    "node_feature_dim": 20,
    "gnn_type": "gat",
    "embedding_dim": 64,
    "hidden_channels": 64,
    "num_layers": 2,
    "history_dim": 16,
    "dropout": 0.2,
    "heads": 4,
    "device": "auto",
    "multi_branch": false,
    "use_dqn_enhancement": false,
    "num_classes": 2
  },
  "environment": {
    "max_steps": 20,
    "max_neighbors": 5,
    "intrinsic_reward_weight": 0.5,
    "step_penalty": -0.01,
    "fraud_reward": 1.0,
    "false_alarm_penalty": -1.0
  },
  "trainer": {
    "num_episodes": 500,
    "batch_size": 64,
    "eval_frequency": 50,
    "checkpoint_frequency": 100,
    "target_update_frequency": 10,
    "curriculum_schedule": [1.0, 0.8, 0.6, 0.4, 0.2, 0.1, 0.02],
    "max_steps_per_episode": 20,
    "num_eval_episodes": 20,
    "multi_branch": {
      "enabled": false,
      "variant": "improved",
      "lambda_branch": 0.25,
      "epsilon_dqn": 0.4,
      "beta_reg": 0.1,
      "temporal_decay": 0.1,
      "adaptive_weighting": true,
      "learning_rate": 0.0005,
      "log_frequency": 25
    }
  },
  "output_dir": "outputs/amlnet_gat",
  "seed": 42,
  "nrows": 10000
}
