{
  "name": "amlnet_rmganets_extended",
  "dataset_type": "amlnet",
  "dataset_path": "data/amlnet/AMLNet_August_2025.csv",
  "agent": {
    "state_dim": 80,
    "action_dim": 6,
    "agent_type": "qrdqn",
    "learning_rate": 0.0005,
    "gamma": 0.99,
    "epsilon_start": 1.0,
    "epsilon_end": 0.05,
    "epsilon_decay": 0.998,
    "buffer_capacity": 50000,
    "use_prioritized_replay": true,
    "prioritized_alpha": 0.6,
    "prioritized_beta": 0.4,
    "prioritized_beta_annealing": 0.001,
    "num_quantiles": 64,
    "n_step": 5,
    "risk_measure": "mean",
    "use_guided_exploration": true,
    "exploration_temperature": 1.0,
    "hidden_dims": [256, 256, 128],
    "device": "auto"
  },
  "gnn": {
    "node_feature_dim": 20,
    "gnn_type": "rmganets",
    "embedding_dim": 64,
    "hidden_channels": 160,
    "num_layers": 2,
    "history_dim": 16,
    "dropout": 0.1,
    "heads": 8,
    "device": "auto",
    "multi_branch": true,
    "use_dqn_enhancement": true,
    "num_classes": 2
  },
  "environment": {
    "max_steps": 200,
    "max_neighbors": 5,
    "intrinsic_reward_weight": 0.5,
    "step_penalty": -0.01,
    "fraud_reward": 1.0,
    "false_alarm_penalty": -1.0
  },
  "trainer": {
    "num_episodes": 2400,
    "batch_size": 32,
    "eval_frequency": 50,
    "checkpoint_frequency": 100,
    "target_update_frequency": 10,
    "curriculum_schedule": [1.0, 0.95, 0.90, 0.85, 0.80, 0.75, 0.70, 0.65, 0.60, 0.55, 0.50],
    "max_steps_per_episode": 200,
    "num_eval_episodes": 20,
    "multi_branch": {
      "enabled": true,
      "variant": "improved",
      "lambda_branch": 0.25,
      "epsilon_dqn": 0.4,
      "beta_reg": 0.1,
      "temporal_decay": 0.1,
      "adaptive_weighting": true,
      "learning_rate": 0.0005,
      "log_frequency": 25
    }
  },
  "output_dir": "outputs/amlnet_rmganets_extended",
  "seed": 42
}
